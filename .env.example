# Endereço público do site, sem barra no final. Defina na Vercel (Settings > Environment Variables).
# Ativa canonical, og:url, og:image e os dados estruturados com URL absoluta.
# Exemplo: https://www.jpglabs.com.br
VITE_SITE_URL=

# Medição e Google Ads (opcionais). Só ativam depois que você criar as contas e colar os códigos.
# Defina na Vercel em Settings > Environment Variables (ambiente Production) e faça um novo deploy.
# ID de medição do Google Analytics 4 (começa com G-)
VITE_GA_MEASUREMENT_ID=
# ID da conta do Google Ads (começa com AW-)
VITE_GADS_ID=
# Rótulo da conversão "Conversa no WhatsApp" (parte depois da barra em AW-XXXX/rotulo)
VITE_GADS_WHATSAPP_LABEL=
# Rótulo da conversão "Formulário enviado" (opcional)
VITE_GADS_LEAD_LABEL=
